Description: opentelemetry-cpp: include <unistd.h> in the Jaeger UDP transport
 TUDPTransport.cc calls ::close() without including <unistd.h>. The thrift
 headers of Debian trixie no longer provide it indirectly: "'::close' has
 not been declared". Tentacle's copy includes the header; do the same.
---
--- a/src/jaegertracing/opentelemetry-cpp/exporters/jaeger/src/TUDPTransport.cc
+++ b/src/jaegertracing/opentelemetry-cpp/exporters/jaeger/src/TUDPTransport.cc
@@ -3,6 +3,8 @@
 
 #include <sstream>  // std::stringstream
 
+#include <unistd.h>
+
 #include "TUDPTransport.h"
 #include "opentelemetry/sdk_config.h"
 
