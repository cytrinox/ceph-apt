#!/usr/bin/env bash
#
# ceph-apt - host-side wrapper around the ceph-apt builder container.
#
#   ./ceph-apt image bookworm trixie          build the builder images
#   ./ceph-apt build 19.2.3 bookworm [opts]   build Ceph into the repo pool
#   ./ceph-apt index [release...]             regenerate apt metadata (unsigned)
#   ./ceph-apt sign [--key=ID] [release...]   sign it locally with your gpg
#   ./ceph-apt fetch-incoming [--dry-run]     move packages built by ceph-apt-cloudbuild
#                                             from S3 into the repo pool
#   ./ceph-apt publish [--key=ID] [release...] index, sign and upload the repo
#                                             to CEPH_APT_S3_PUBLISH_URL
#   ./ceph-apt shell bookworm                 debug shell in the builder
#
# Global options (before the command):
#   -c, --config FILE use FILE instead of ./ceph-apt.conf
#                     (or set CEPH_APT_CONF=FILE)
#
# Build options:
#   --rev N           rebuild number, the uN in 19.2.3-1~deb12uN (default 1).
#                     Bump it to rebuild a version that is already in the pool.
#   --index           run index (and sign, if SIGNING_KEY is set) afterwards
#   --jobs N          parallel compile jobs (default: min(nproc, RAM/3GB))
#   --with-dbg        also build and publish the -dbg packages (several GB)
#   --release NAME    Ceph release name if the version is not known yet
#   --keep            keep the build tree in WORK_DIR/build
#   --prepare-only    stop after installing the build dependencies
#   --force           overwrite packages already in the pool
#
# Settings come from ./ceph-apt.conf by default (see ceph-apt.conf.example).
#
set -euo pipefail

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
CONF=${CEPH_APT_CONF:-}
while [ $# -gt 0 ]; do
    case "$1" in
        -c|--config) [ $# -ge 2 ] || die "$1 needs a file"; CONF=$2; shift 2 ;;
        --config=*) CONF=${1#--config=}; shift ;;
        *) break ;;
    esac
done
if [ -n "$CONF" ]; then
    # An explicitly chosen config must exist; the default one is optional.
    [ -f "$CONF" ] || die "config file $CONF not found"
else
    CONF=$HERE/ceph-apt.conf
fi
# shellcheck disable=SC1090
[ ! -f "$CONF" ] || . "$CONF"
# Let a GNUPGHOME from the config reach gpg.
[ -z "${GNUPGHOME:-}" ] || export GNUPGHOME

REPO_DIR=${REPO_DIR:-$HERE/repo}
WORK_DIR=${WORK_DIR:-$HERE/work}
CACHE_DIR=${CACHE_DIR:-$HERE/ccache}
IMAGE=${IMAGE:-localhost/ceph-apt-builder}
INDEX_DIST=${INDEX_DIST:-bookworm}
ENGINE=${ENGINE:-$(command -v podman || command -v docker || true)}
VOLUME_OPTS=${VOLUME_OPTS:-}
# Where ./ceph-apt-cloudbuild uploads builds; keep in sync with DEFAULT_S3_URL there.
CEPH_APT_S3_URL=${CEPH_APT_S3_URL:-https://nbg1.your-objectstorage.com/ceph-apt/incoming}
# Where `publish` uploads the signed repository.
CEPH_APT_S3_PUBLISH_URL=${CEPH_APT_S3_PUBLISH_URL:-https://nbg1.your-objectstorage.com/ceph-apt/repo}

# Settings forwarded into the container when set.
PASS_ENV=(DEBFULLNAME DEBEMAIL ARCHES REPO_ORIGIN REPO_LABEL
          CCACHE_MAXSIZE CEPH_DOWNLOAD_URL CEPH_EXTRA_CMAKE_ARGS
          DEB_BUILD_PROFILES BUILD_ARCH_INDEP)

usage() {
    # Print the header comment.
    awk 'NR < 3 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit "${1:-0}"
}

base_image() {
    case "$1" in
        bullseye|bookworm|trixie|forky|sid) echo "debian:$1" ;;
        jammy|noble|resolute) echo "ubuntu:$1" ;;
        *) die "unknown distribution '$1' (known: bookworm trixie forky jammy noble resolute)" ;;
    esac
}

host_arch() {
    case "$(uname -m)" in
        x86_64) echo amd64 ;;
        aarch64|arm64) echo arm64 ;;
        *) uname -m ;;
    esac
}

# vol <host> <container> [ro]
vol() {
    local opts=${3:-}
    [ -z "$VOLUME_OPTS" ] || opts="${opts:+$opts,}$VOLUME_OPTS"
    printf '%s:%s%s' "$1" "$2" "${opts:+:$opts}"
}

# run <dist> [engine run args...] -- <ceph-deb args...>
run() {
    local dist=$1 args=() v
    shift
    base_image "$dist" > /dev/null
    [ -n "$ENGINE" ] || die "neither podman nor docker found"
    mkdir -p "$REPO_DIR" "$WORK_DIR"
    while [ $# -gt 0 ] && [ "$1" != -- ]; do args+=("$1"); shift; done
    [ $# -eq 0 ] || shift
    [ -t 0 ] && [ -t 1 ] && args+=(-it)
    for v in "${PASS_ENV[@]}"; do
        [ -z "${!v:-}" ] || args+=(-e "$v=${!v}")
    done
    # Scripts and patches come from this checkout, so editing them needs no
    # image rebuild; the image only provides the toolchain.
    "$ENGINE" run --rm --init \
        -v "$(vol "$REPO_DIR" /repo)" \
        -v "$(vol "$WORK_DIR" /work)" \
        -v "$(vol "$HERE/scripts/ceph-deb" /usr/local/bin/ceph-deb ro)" \
        -v "$(vol "$HERE/scripts/lib" /usr/local/lib/ceph-deb ro)" \
        -v "$(vol "$HERE/patches" /usr/local/share/ceph-deb/patches ro)" \
        "${args[@]}" "$IMAGE:$dist" "$@"
}

cmd_image() {
    [ $# -gt 0 ] || die "usage: ceph-apt image <dist>..."
    [ -n "$ENGINE" ] || die "neither podman nor docker found"
    local dist
    for dist in "$@"; do
        "$ENGINE" build --pull \
            --build-arg "BASE=$(base_image "$dist")" \
            -t "$IMAGE:$dist" -f "$HERE/Containerfile" "$HERE"
    done
}

cmd_build() {
    [ $# -ge 2 ] || die "usage: ceph-apt build <version> <dist> [--index] [ceph-deb build options]"
    local version=$1 dist=$2 opts=() do_index=0 cache o
    shift 2
    base_image "$dist" > /dev/null
    for o in "$@"; do
        if [ "$o" = --index ]; then do_index=1; else opts+=("$o"); fi
    done
    cache="$CACHE_DIR/$dist-$(host_arch)"
    mkdir -p "$cache"
    run "$dist" -v "$(vol "$cache" /ccache)" -- build "$version" "${opts[@]}"
    [ "$do_index" = 1 ] || return 0
    cmd_index
    if [ -n "${SIGNING_KEY:-}" ]; then
        cmd_sign
    else
        echo "==> SIGNING_KEY is not set, run ./ceph-apt sign --key=<ID> before uploading" >&2
    fi
}

cmd_index() {
    run "$INDEX_DIST" -- index "$@"
}

# Signs on the host with the user's own gpg (agent, pinentry, smartcards);
# the key never enters a container.
cmd_sign() {
    local key=${SIGNING_KEY:-} releases=() release d rel suite n=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --key=*) key=${1#--key=} ;;
            --key) [ $# -ge 2 ] || die "--key needs a key ID"; key=$2; shift ;;
            -*) die "unknown option $1" ;;
            *) releases+=("$1") ;;
        esac
        shift
    done
    [ -n "$key" ] || die "no signing key: set SIGNING_KEY in $CONF or pass --key=<ID>"
    command -v gpg > /dev/null || die "gpg not found"
    gpg --batch --list-secret-keys "$key" > /dev/null 2>&1 \
        || die "no secret key '$key' in your keyring${GNUPGHOME:+ ($GNUPGHOME)}"

    if [ ${#releases[@]} -eq 0 ]; then
        for d in "$REPO_DIR"/*/dists; do
            [ -d "$d" ] && releases+=("$(basename "$(dirname "$d")")")
        done
    fi
    [ ${#releases[@]} -gt 0 ] || die "nothing to sign in $REPO_DIR, run ./ceph-apt index first"

    local gpg=(gpg --yes --local-user "$key" --digest-algo SHA512)
    # Without a terminal there is no pinentry; rely on the agent's cache.
    [ -t 0 ] || gpg+=(--batch)

    for release in "${releases[@]}"; do
        [ -d "$REPO_DIR/$release/dists" ] || die "$REPO_DIR/$release/dists does not exist"
        for rel in "$REPO_DIR/$release"/dists/*/Release; do
            [ -e "$rel" ] || continue
            suite=$(dirname "$rel")
            echo "==> Signing $release/$(basename "$suite")" >&2
            "${gpg[@]}" --clearsign --output "$suite/InRelease.tmp" "$rel"
            "${gpg[@]}" --armor --detach-sign --output "$suite/Release.gpg.tmp" "$rel"
            mv "$suite/InRelease.tmp" "$suite/InRelease"
            mv "$suite/Release.gpg.tmp" "$suite/Release.gpg"
            n=$((n + 1))
        done
    done
    [ "$n" -gt 0 ] || die "no Release files found, run ./ceph-apt index first"

    gpg --batch --armor --export "$key" > "$REPO_DIR/ceph-apt.asc.tmp"
    mv "$REPO_DIR/ceph-apt.asc.tmp" "$REPO_DIR/ceph-apt.asc"
    echo "==> Signed $n suite(s) with $key, public key: $REPO_DIR/ceph-apt.asc" >&2
}

# rclone <args...>: rclone without a config file; remotes come from the
# environment (see s3_remote).
rclone() {
    command -v rclone > /dev/null || die "rclone not found"
    command rclone --config "" "$@"
}

# s3_remote <name> <url>: configures the rclone remote <name> for an S3 URL
# (https://<endpoint>/<bucket>[/<prefix>] or s3://<bucket>[/<prefix>]) and
# sets S3_REMOTE to the remote path, e.g. "incoming:ceph-apt/incoming".
s3_remote() {
    local name=$1 url=$2 rest host path region=${CEPH_APT_S3_REGION:-} var
    [ -n "${CEPH_APT_S3_ACCESS_KEY_ID:-}" ] && [ -n "${CEPH_APT_S3_SECRET_ACCESS_KEY:-}" ] \
        || die "set CEPH_APT_S3_ACCESS_KEY_ID and CEPH_APT_S3_SECRET_ACCESS_KEY"
    case "$url" in
        s3://*) host=""; path=${url#s3://} ;;
        http://*/*|https://*/*) rest=${url#*://}; host=${rest%%/*}; path=${rest#*/} ;;
        *) die "unsupported S3 URL $url, use https://<endpoint>/<bucket>[/<prefix>] or s3://<bucket>[/<prefix>]" ;;
    esac
    path=${path%/}
    [ -n "$path" ] || die "no bucket in S3 URL $url"

    var=RCLONE_CONFIG_${name^^}
    export "${var}_TYPE=s3" "${var}_NO_CHECK_BUCKET=true"
    export "${var}_ACCESS_KEY_ID=$CEPH_APT_S3_ACCESS_KEY_ID"
    export "${var}_SECRET_ACCESS_KEY=$CEPH_APT_S3_SECRET_ACCESS_KEY"
    if [ -n "$host" ]; then
        export "${var}_PROVIDER=Other" "${var}_ENDPOINT=${url%%://*}://$host"
        # Hetzner Object Storage signs requests with its location as region.
        if [ -z "$region" ] && [[ $host =~ ^([a-z0-9]+)\.your-objectstorage\.com$ ]]; then
            region=${BASH_REMATCH[1]}
        fi
    else
        export "${var}_PROVIDER=AWS"
    fi
    [ -z "$region" ] || export "${var}_REGION=$region"
    S3_REMOTE=$name:$path
}

# Moves everything below CEPH_APT_S3_URL into REPO_DIR. Existing files are
# never overwritten: a file that differs from the pool copy stays in S3 and
# rclone reports an error.
cmd_fetch_incoming() {
    local opts=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) opts+=(--dry-run) ;;
            *) die "unknown option $1" ;;
        esac
        shift
    done
    s3_remote incoming "$CEPH_APT_S3_URL"

    mkdir -p "$REPO_DIR"
    echo "==> Moving new files from $CEPH_APT_S3_URL to $REPO_DIR" >&2
    rclone move --immutable --delete-empty-src-dirs --stats-one-line -v "${opts[@]}" "$S3_REMOTE" "$REPO_DIR"
    echo "==> Done. Run ./ceph-apt publish to index, sign and upload them." >&2
}

# Indexes and signs, then uploads REPO_DIR to CEPH_APT_S3_PUBLISH_URL in three
# passes, so clients never see metadata that references missing files:
# packages first, then the package indexes, then the signed Release files.
# Nothing is deleted on the target.
cmd_publish() {
    local sign_opts=() releases=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --key=*) sign_opts+=("$1") ;;
            --key) [ $# -ge 2 ] || die "--key needs a key ID"; sign_opts+=("--key=$2"); shift ;;
            -*) die "unknown option $1" ;;
            *) releases+=("$1") ;;
        esac
        shift
    done
    s3_remote publish "$CEPH_APT_S3_PUBLISH_URL"

    cmd_index "${releases[@]}"
    cmd_sign "${sign_opts[@]}" "${releases[@]}"

    local copy=(rclone copy --stats-one-line -v "$REPO_DIR" "$S3_REMOTE")
    echo "==> Uploading packages to $CEPH_APT_S3_PUBLISH_URL" >&2
    "${copy[@]}" --exclude '/*/dists/**'
    echo "==> Uploading package indexes" >&2
    "${copy[@]}" --include '/*/dists/*/main/**'
    echo "==> Uploading signed Release files" >&2
    "${copy[@]}" --include '/*/dists/*/{Release,InRelease,Release.gpg}'
    echo "==> Published" >&2
}

cmd=${1:-help}
[ $# -eq 0 ] || shift
case "$cmd" in
    image) cmd_image "$@" ;;
    build) cmd_build "$@" ;;
    index) cmd_index "$@" ;;
    sign) cmd_sign "$@" ;;
    fetch-incoming) cmd_fetch_incoming "$@" ;;
    publish) cmd_publish "$@" ;;
    shell) [ $# -ge 1 ] || die "usage: ceph-apt shell <dist>"; d=$1; shift; run "$d" -- shell "$@" ;;
    help|-h|--help) usage ;;
    *) usage 1 >&2 ;;
esac
